# BOT Omikuji. Copy to `.env.local` for local development.
# `.env*` files are git-ignored. Never commit real keys.

# --- Frontend (Vite, public at build time) -------------------------------
# FortuneContract on BOT Chain Mainnet (chain 677). Leave empty until deployed:
# the app then shows a clear "contract not configured" state and only offers
# off-chain guest trials. There is intentionally no fallback address.
VITE_CONTRACT_ADDRESS=
# Block number of the deployment (from deployments/botchain-mainnet.json).
# Optional; only bounds the log scan used to recover tx hashes on new devices.
VITE_CONTRACT_DEPLOY_BLOCK=
# Defaults: https://rpc.botchain.ai and https://scan.botchain.ai
VITE_BOTCHAIN_RPC_URL=
VITE_BOTCHAIN_EXPLORER_URL=
# Dedicated Supabase project for this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# https://cloud.walletconnect.com — needed for WalletConnect QR / mobile deep links.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional switches
VITE_DEMO_MODE=false
VITE_ENABLE_GOOGLE_AUTH=false

# --- Contract deployment (Hardhat) ---------------------------------------
# Prefer the encrypted keystore instead of this variable:
#   npx hardhat keystore set BOTCHAIN_DEPLOYER_PRIVATE_KEY
# BOTCHAIN_DEPLOYER_PRIVATE_KEY=
BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# --- Supabase Edge Function secrets (set with `supabase secrets set`) -----
# CONTRACT_ADDRESS=0x...
# BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# ALLOWED_ORIGIN=https://<your-production-domain>
